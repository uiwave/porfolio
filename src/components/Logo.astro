<a
  href="#inicio"
  class="group relative inline-flex items-center gap-3 focus:outline-none"
  aria-label="Inicio"
>
  <div
    class="relative flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 bg-primary border-2 border-border shadow-[4px_4px_0_0_var(--border)] transition-all duration-200 group-hover:-translate-x-0.5 group-hover:-translate-y-0.5 group-hover:shadow-[6px_6px_0_0_var(--border)] group-hover:bg-foreground"
  >
    <span
      class="font-black text-2xl sm:text-3xl text-primary-foreground tracking-tighter select-none -rotate-3 transition-all duration-200 group-hover:rotate-0 group-hover:text-background"
    >
      E
    </span>
    <span
      class="absolute -top-1.5 -right-1.5 w-3.5 h-3.5 bg-primary-foreground border-2 border-border rounded-full"
      aria-hidden="true"
    ></span>
  </div>

  <div
    class="hidden sm:flex flex-col text-left bg-background border-2 border-border px-2.5 py-0.5 shadow-[3px_3px_0_0_var(--border)]"
  >
    <span
      class="font-black text-sm text-foreground uppercase tracking-tight leading-none"
    >
      Erick<span class="text-primary">.dev</span>
    </span>
    <span
      class="text-[9px] font-extrabold text-foreground/70 uppercase tracking-widest leading-none mt-0.5"
    >
      Frontend / FS
    </span>
  </div>
</a>
