---
---

<div
  class="w-full max-w-sm border-[3px] border-border bg-background shadow-[6px_6px_0_0_var(--border)] -rotate-1 transition-all duration-300"
  aria-hidden="true"
>
  <div
    class="flex items-center gap-2 px-3 py-2 border-b-[3px] border-border bg-accent-yellow"
  >
    <span class="w-3 h-3 bg-red-500 border-2 border-border"></span>
    <span class="w-3 h-3 bg-accent-yellow border-2 border-border"></span>
    <span class="w-3 h-3 bg-green-500 border-2 border-border"></span>
    <span
      class="ml-2 text-[10px] font-black uppercase tracking-widest text-foreground"
      >portfolio — bash</span
    >
  </div>
  <div class="p-4 text-xs sm:text-sm font-medium leading-relaxed">
    <p>
      <span class="text-primary font-black select-none">$</span> cd
      portfolio
    </p>
    <p>
      <span class="text-primary font-black select-none">$</span> npm run dev
      <span class="text-primary font-black">-- --open</span>
    </p>
    <p class="text-green-600 font-black">✓ listo en 0.2s — con ♥ y café</p>
    <p class="flex items-center gap-1">
      <span class="text-primary font-black select-none">$</span>
      <span class="blink inline-block w-2.5 h-4 bg-primary border-2 border-border align-middle"></span>
    </p>
  </div>
</div>