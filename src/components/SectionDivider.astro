---
interface Props {
  simbolo?: string;
}

const { simbolo = "✱" } = Astro.props;
---

<div class="relative w-full px-4 sm:px-6 lg:px-12 py-8 sm:py-10" aria-hidden="true">
  <div class="max-w-6xl mx-auto flex items-center gap-4 sm:gap-8">
    <div
      class="h-3 flex-1 border-y-2 border-border"
      style="background-image: repeating-linear-gradient(135deg, var(--grid) 0 10px, transparent 10px 22px);"
    ></div>
    <span
      class="inline-flex items-center justify-center w-10 h-10 rotate-45 bg-primary border-2 border-border shadow-[3px_3px_0_0_var(--border)]"
    >
      <span
        class="inline-block -rotate-45 text-sm font-black text-primary-foreground"
        >{simbolo}</span
      >
    </span>
    <div
      class="h-3 flex-1 border-y-2 border-border"
      style="background-image: repeating-linear-gradient(135deg, var(--grid) 0 10px, transparent 10px 22px);"
    ></div>
  </div>
</div>