---
import Logo from "@/components/Logo.astro";
import { NAV_ITEMS } from "@/const";
---

<header
  id="site-header"
  class="fixed top-0 left-0 w-full z-50 px-4 sm:px-6 lg:px-12 py-4 pointer-events-none transition-colors duration-200"
>
  <div
    class="max-w-6xl mx-auto flex items-center justify-between gap-3 pointer-events-auto"
  >
    <Logo />

    <nav
      class="hidden lg:flex items-center gap-1 lg:gap-2 bg-background border-2 border-border p-1.5 shadow-[5px_5px_0_0_var(--border)]"
      aria-label="Navegación principal"
    >
      {NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class="px-3 py-1.5 font-black text-xs lg:text-sm text-foreground uppercase tracking-wider transition-all duration-150 border-2 border-transparent hover:bg-foreground hover:text-background hover:border-border"
        >
          {item.nombre}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        data-theme-toggle
        aria-label="Cambiar tema"
        class="inline-flex items-center justify-center w-10 h-10 bg-primary border-2 border-border text-primary-foreground shadow-[4px_4px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
      >
        <svg
          data-theme-icon="light"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          class="w-5 h-5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg
          data-theme-icon="dark"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          class="w-5 h-5 hidden"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg
          data-theme-icon="system"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          class="w-5 h-5 hidden"
          aria-hidden="true"
        >
          <rect x="2" y="3" width="20" height="14" rx="0" />
          <path d="M8 21h8M12 17v4" />
        </svg>
      </button>

      <button
        id="menu-btn"
        class="md:hidden lg:hidden flex flex-col justify-center items-center w-11 h-11 bg-background border-2 border-border shadow-[4px_4px_0_0_var(--border)] active:shadow-none transition-all duration-150 focus:outline-none gap-1.5"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="w-6 h-0.5 bg-foreground"></span>
        <span class="w-6 h-0.5 bg-foreground"></span>
        <span class="w-6 h-0.5 bg-foreground"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden lg:hidden max-w-6xl mx-auto mt-3 bg-background border-2 border-border p-4 shadow-[6px_6px_0_0_var(--border)] pointer-events-auto flex-col gap-2"
  >
    {NAV_ITEMS.map((item) => (
      <a
        href={item.href}
        class="block px-4 py-2 font-black text-sm text-background uppercase bg-foreground border-2 border-border shadow-[2px_2px_0_0_var(--border)] hover:bg-primary hover:text-primary-foreground transition-colors"
      >
        {item.nombre}
      </a>
    ))}
    <button
      type="button"
      data-theme-toggle
      class="inline-flex items-center justify-center gap-2 px-4 h-10 w-full bg-primary border-2 border-border text-primary-foreground font-bold text-sm uppercase shadow-[4px_4px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150"
    >
      <svg
        data-theme-icon="light"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="square"
        class="w-4 h-4"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
      <svg
        data-theme-icon="dark"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="square"
        class="w-4 h-4 hidden"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg
        data-theme-icon="system"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="square"
        class="w-4 h-4 hidden"
        aria-hidden="true"
      >
        <rect x="2" y="3" width="20" height="14" rx="0" />
        <path d="M8 21h8M12 17v4" />
      </svg>
      <span data-theme-label class="font-bold text-xs uppercase tracking-wider"
        >Tema</span
      >
    </button>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const navItems = mobileMenu?.querySelectorAll("a");

  menuBtn?.addEventListener("click", () => {
    const oculto = mobileMenu?.classList.toggle("hidden") ?? false;
    mobileMenu?.classList.toggle("flex", !oculto);
    menuBtn?.setAttribute("aria-expanded", String(!oculto));
  });

  navItems?.forEach((enlace) => {
    enlace.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      mobileMenu?.classList.remove("flex");
      menuBtn?.setAttribute("aria-expanded", "false");
    });
  });

  const activarFondo = () => {
    const scrolled = window.scrollY > 12;
    header?.classList.toggle("bg-background", scrolled);
    header?.classList.toggle("border-b-2", scrolled);
    header?.classList.toggle("border-border", scrolled);
  };

  window.addEventListener("scroll", activarFondo, { passive: true });
  activarFondo();

  const botonesTema = document.querySelectorAll("[data-theme-toggle]");

  const obtenerModo = (): string =>
    localStorage.getItem("theme") || "system";

  const esOscuro = (modo: string): boolean =>
    modo === "dark" ||
    (modo === "system" &&
      window.matchMedia("(prefers-color-scheme: dark)").matches);

  const aplicarTema = () => {
    const modo = obtenerModo();
    const oscuro = esOscuro(modo);
    const temaActual = oscuro ? "dark" : "light";
    document.documentElement.setAttribute("data-theme", temaActual);

    document.querySelectorAll("[data-theme-icon]").forEach((icono) => {
      icono.classList.toggle(
        "hidden",
        icono.getAttribute("data-theme-icon") !== modo,
      );
    });

    document.querySelectorAll("[data-theme-label]").forEach((etiqueta) => {
      etiqueta.textContent =
        modo === "system"
          ? "Sistema"
          : oscuro
            ? "Oscuro"
            : "Claro";
    });

    botonesTema.forEach((boton) => {
      boton.setAttribute(
        "aria-label",
        `Cambiar tema (actual: ${modo === "system" ? "sistema" : oscuro ? "oscuro" : "claro"})`,
      );
    });
  };

  botonesTema.forEach((boton) => {
    boton.addEventListener("click", () => {
      const orden = ["light", "dark", "system"];
      const siguiente =
        orden[(orden.indexOf(obtenerModo()) + 1) % orden.length];
      localStorage.setItem("theme", siguiente);
      aplicarTema();
    });
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", aplicarTema);

  aplicarTema();
</script>