---
import { Image } from "astro:assets";
import profileImage from "@/assets/imgs/profile.jpg";
import { SOCIAL_LINKS } from "@/const";
---

<section
  class="relative w-full overflow-hidden px-4 sm:px-6 lg:px-8 py-16 md:py-24"
  aria-label="Introducción profesional"
>
  <div class="max-w-6xl mx-auto w-full z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-8 flex flex-col items-start">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 mb-6 border-2 border-border bg-primary text-primary-foreground font-bold text-xs uppercase shadow-[2px_2px_0px_0px_var(--border)]"
          role="status"
        >
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-foreground opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-primary-foreground"
            ></span>
          </span>
          Disponible para nuevos proyectos
        </div>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-black leading-[1.2] text-accent mb-4 uppercase tracking-tight"
        >
          Hola, soy <span class="text-primary">Erick</span><br />
          <span
            class="bg-primary px-2 py-0.5 mt-1 inline-block border-2 border-border text-white shadow-[4px_4px_0px_0px_var(--border)]"
          >
            Full-Stack
          </span>{" "}
          <span class="inline-block mt-2">Developer</span>
        </h1>
        <p
          class="mb-6 text-base md:text-lg font-medium leading-relaxed max-w-xl"
        >
          +2 años de experiencia construyendo aplicaciones web{" "}
          <strong
            class="underline decoration-primary decoration-3 underline-offset-2"
          >
            modernas y escalables
          </strong>. Me enfoco en resolver problemas reales con código limpio y
          UI/UX intuitivo.
        </p>
        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
          <a
            href="#proyectos"
            class="inline-flex items-center justify-center px-6 h-12 bg-primary border-2 border-border text-primary-foreground font-bold text-sm uppercase shadow-[5px_5px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[7px_7px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            Ver Proyectos
          </a>
          <a
            href={SOCIAL_LINKS.cv.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar el perfil de GitHub de Erick"
            class="inline-flex items-center justify-center w-12 h-12 bg-primary border-2 border-border text-primary-foreground shadow-[5px_5px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[7px_7px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            <SOCIAL_LINKS.cv.icon class="w-5 h-5" />
          </a>
          <a
            href={SOCIAL_LINKS.github.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar el perfil de GitHub de Erick"
            class="inline-flex items-center justify-center w-12 h-12 bg-primary border-2 border-border text-primary-foreground shadow-[5px_5px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[7px_7px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            <SOCIAL_LINKS.github.icon class="w-5 h-5" />
          </a>
          <a
            href={SOCIAL_LINKS.linkedin.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar el perfil de LinkedIn de Erick"
            class="inline-flex items-center justify-center w-12 h-12 bg-primary border-2 border-border text-primary-foreground shadow-[5px_5px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[7px_7px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            <SOCIAL_LINKS.linkedin.icon class="w-5 h-5" />
          </a>
        </div>
      </div>
      <div class="hidden md:col-span-4 md:flex justify-end items-center">
        <div class="relative w-64 h-64 lg:w-72 lg:h-72 group">
          <div
            class="relative w-full h-full border-3 border-border rounded-xl shadow-[6px_6px_0_0_var(--border)] overflow-hidden transition-all duration-300 group-hover:shadow-[10px_10px_0_0_var(--border)]"
          >
            <div class="absolute inset-0 flex items-start justify-center">
              <Image
                src={profileImage}
                alt="Erick sonriendo en su foto de perfil profesional"
                width={300}
                height={450}
                widths={[256, 300]}
                sizes="(max-width: 1024px) 256px, 300px"
                class="w-full h-auto min-h-full object-cover object-top transform transition-transform duration-500 ease-out group-hover:scale-105"
                loading="eager"
                format="avif"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
