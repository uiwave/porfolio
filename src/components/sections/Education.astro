---
import Heading from "@/components/Heading.astro";

const formaciones = [
  {
    institucion: "Universidad Nacional de Ingeniería",
    titulo: "Ingeniería en Sistemas",
    periodo: "2016 — 2021",
    descripcion:
      "Graduado con especialización en desarrollo de software. Participé en proyectos académicos de arquitectura web, bases de datos distribuidas y metodologías ágiles.",
  },
  {
    institucion: "Bootcamp Full-Stack",
    titulo: "Desarrollo Web Full-Stack",
    periodo: "2021 — 2022",
    descripcion:
      "Formación intensiva en JavaScript, React, Node.js y bases de datos. Construí proyectos reales de principio a fin con despliegue en producción.",
  },
  {
    institucion: "Certificación Profesional",
    titulo: "React Avanzado y Arquitectura Frontend",
    periodo: "2023",
    descripcion:
      "Certificación en patrones de diseño de componentes, estado global, testing y rendimiento en aplicaciones React a gran escala.",
  },
];
---

<section
  id="formacion"
  class="relative w-full pt-16 sm:pt-24 px-4 sm:px-6 lg:px-12 overflow-hidden"
>
  <div class="max-w-6xl mx-auto w-full">
    <Heading badge="🎓 Formación" title="Formación" highlight="Académica" />
    <div class="relative">
      <div
        class="absolute left-2.25 top-2 bottom-2 border-l-2 border-dashed border-border"
        aria-hidden="true"
      ></div>
      <div class="flex flex-col gap-6 lg:gap-8">
        {formaciones.map((formacion) => (
          <div class="relative pl-12">
            <span
              class="absolute left-0 top-1.5 w-5 h-5 rotate-45 bg-primary border-2 border-border shadow-[2px_2px_0_0_var(--border)]"
              aria-hidden="true"
            ></span>
            <span
              class="inline-block mb-3 border-2 border-border bg-primary text-primary-foreground px-3 py-1.5 text-xs font-black uppercase shadow-[3px_3px_0_0_var(--border)]"
            >
              {formacion.periodo}
            </span>
            <div
              class="bg-background border-2 border-border p-4 sm:p-5 shadow-[4px_4px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_var(--border)] transition-all duration-150"
            >
              <h3 class="font-black text-base sm:text-lg uppercase tracking-tight leading-tight">
                {formacion.titulo}
              </h3>
              <span
                class="text-xs font-black uppercase text-primary tracking-wider"
              >
                // {formacion.institucion}
              </span>
              <p class="mt-2 text-sm font-medium leading-relaxed">
                {formacion.descripcion}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
