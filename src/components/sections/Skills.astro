---
import Heading from "@/components/Heading.astro";
import { SKILLS_ROWS } from "@/const";
---

<section
  id="skills"
  class="relative w-full py-8 sm:py-10 overflow-hidden bg-accent-yellow border-y-[3px] border-border"
>
  <div class="max-w-6xl mx-auto w-full">
    <div class="flex flex-col gap-6 sm:gap-8">
      {SKILLS_ROWS.map((fila) => (
        <div class="marquee-row relative overflow-hidden">
          <div
            class="absolute inset-y-0 left-0 w-16 md:w-32 z-10 pointer-events-none bg-linear-to-r from-accent-yellow to-transparent"
            aria-hidden="true"
          ></div>
          <div
            class="absolute inset-y-0 right-0 w-16 md:w-32 z-10 pointer-events-none bg-linear-to-l from-accent-yellow to-transparent"
            aria-hidden="true"
          ></div>
          <div
            class:list={[
              "marquee-track flex w-max py-2",
              fila.tipo === "derecha" ? "marquee-derecha" : "marquee-izquierda",
            ]}
            style={`animation-duration: ${fila.duracion};`}
          >
            {[...fila.iconos, ...fila.iconos, ...fila.iconos, ...fila.iconos].map(
              (Icono, index) => (
                <div class="px-3 sm:px-4 group">
                  <div
                    class="flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-background border-[3px] border-border shadow-[5px_5px_0_0_var(--border)] transition-all duration-150 group-hover:-translate-x-0.5 group-hover:-translate-y-0.5 group-hover:shadow-[7px_7px_0_0_var(--border)]"
                  >
                    <Icono class="w-8 h-8 sm:w-9 sm:h-9 text-foreground transition-colors duration-150 group-hover:text-primary" />
                  </div>
                </div>
              ),
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee-derecha {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @keyframes marquee-izquierda {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .marquee-derecha {
    animation-name: marquee-derecha;
  }

  .marquee-izquierda {
    animation-name: marquee-izquierda;
  }

  .marquee-row:hover .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>