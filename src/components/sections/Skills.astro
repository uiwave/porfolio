---
import Heading from "@/components/Heading.astro";
import ReactIcon from "@/assets/icons/react.svg";
import AstroIcon from "@/assets/icons/astro.svg";
import NextjsIcon from "@/assets/icons/nextjs.svg";
import SvelteIcon from "@/assets/icons/svelte.svg";
import VueIcon from "@/assets/icons/vuedotjs.svg";
import AngularIcon from "@/assets/icons/angular.svg";
import GithubIcon from "@/assets/icons/github.svg";
import LinkedinIcon from "@/assets/icons/linkedin.svg";
import CVIcon from "@/assets/icons/readdotcv.svg";

const fila1 = [
  ReactIcon,
  AstroIcon,
  NextjsIcon,
  SvelteIcon,
  VueIcon,
  AngularIcon,
  GithubIcon,
  LinkedinIcon,
  CVIcon,
];
const fila2 = [
  VueIcon,
  AngularIcon,
  ReactIcon,
  SvelteIcon,
  AstroIcon,
  NextjsIcon,
  LinkedinIcon,
  GithubIcon,
  CVIcon,
];

const filas = [
  { iconos: fila1, tipo: "derecha", duracion: "60s" },
  { iconos: fila2, tipo: "izquierda", duracion: "50s" },
];
---

<section
  id="skills"
  class="relative w-full py-5 overflow-hidden"
>
  <div class="max-w-6xl mx-auto w-full">
    <div class="flex flex-col gap-6 sm:gap-8">
      {filas.map((fila) => (
        <div class="marquee-row relative overflow-hidden">
          <div
            class="absolute inset-y-0 left-0 w-16 md:w-32 z-10 pointer-events-none bg-linear-to-r from-background to-transparent"
            aria-hidden="true"
          ></div>
          <div
            class="absolute inset-y-0 right-0 w-16 md:w-32 z-10 pointer-events-none bg-linear-to-l from-background to-transparent"
            aria-hidden="true"
          ></div>
          <div
            class:list={[
              "marquee-track flex w-max",
              fila.tipo === "derecha" ? "marquee-derecha" : "marquee-izquierda",
            ]}
            style={`animation-duration: ${fila.duracion};`}
          >
            {[...fila.iconos, ...fila.iconos, ...fila.iconos, ...fila.iconos].map(
              (Icono, index) => (
                <div class="px-3 sm:px-4 group">
                  <div
                    class="flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 bg-background border-2 border-border shadow-[4px_4px_0_0_var(--border)] transition-all duration-150 group-hover:-translate-x-0.5 group-hover:-translate-y-0.5 group-hover:shadow-[6px_6px_0_0_var(--border)]"
                  >
                    <Icono class="w-7 h-7 sm:w-8 sm:h-8 text-foreground transition-colors duration-150 group-hover:text-primary" />
                  </div>
                </div>
              ),
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee-derecha {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @keyframes marquee-izquierda {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .marquee-derecha {
    animation-name: marquee-derecha;
  }

  .marquee-izquierda {
    animation-name: marquee-izquierda;
  }

  .marquee-row:hover .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>