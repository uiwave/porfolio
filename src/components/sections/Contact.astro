---
import Heading from "@/components/Heading.astro";
import { DATOS_CONTACTO } from "@/const";
import DecoCorners from "@/components/DecoCorners.astro";

const decoraciones = [
  { simbolo: "✱", color: "text-accent-yellow", pos: "top-6 left-8", tamano: "text-5xl" },
  { simbolo: "*", color: "text-primary", pos: "bottom-10 right-8", tamano: "text-4xl" },
];
---

<section
  id="contacto"
  class="relative w-full py-16 sm:py-24 px-4 sm:px-6 lg:px-12 overflow-hidden"
>
  <DecoCorners decoraciones={decoraciones} />
  <div class="max-w-6xl mx-auto w-full">
    <Heading badge="📬 Contacto" title="Hablemos de tu" highlight="Proyecto" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      <div class="lg:col-span-5 flex flex-col gap-4">
        {
          DATOS_CONTACTO.map((item) => (
            <a
              href={item.href}
              class="group bg-background border-[3px] border-border p-5 shadow-[6px_6px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_var(--border)] hover:bg-accent-yellow transition-all"
            >
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-black uppercase text-primary tracking-wider">
                    // {item.label}
                  </span>
                  <p class="font-black text-lg truncate">{item.valor}</p>
                </div>

                <span class="text-2xl group-hover:scale-110 transition-transform">
                  {item.emoji}
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <div
        class="card-fold relative lg:col-span-7 bg-background border-[3px] border-border p-6 sm:p-8 shadow-[6px_6px_0_0_var(--border)]"
      >
        <span
          class="absolute -top-5 -right-3 sm:-right-5 z-20 rotate-3 bg-accent-yellow border-[3px] border-border text-foreground px-4 py-2 text-xs font-black uppercase shadow-[4px_4px_0_0_var(--border)]"
          aria-hidden="true"
        >
          Respondo en &lt; 24h ⚡
        </span>
        <span
          class="absolute -bottom-5 right-6 z-20 -rotate-8 bg-accent-pink border-[3px] border-border text-foreground px-3 py-1.5 text-[10px] font-black uppercase tracking-widest shadow-[3px_3px_0_0_var(--border)]"
          aria-hidden="true"
        >
          100% Serio
        </span>
        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="nombre"
                class="block text-xs font-black uppercase tracking-wider mb-1.5 text-primary"
              >
                Nombre
              </label>

              <input
                type="text"
                id="nombre"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full bg-background border-2 border-border p-3.5 text-sm font-medium focus:outline-none focus:border-primary"
              />
            </div>

            <div>
              <label
                for="email"
                class="block text-xs font-black uppercase tracking-wider mb-1.5 text-primary"
              >
                Email
              </label>

              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu@email.com"
                class="w-full bg-background border-2 border-border p-3.5 text-sm font-medium focus:outline-none focus:border-primary"
              />
            </div>
          </div>

          <div>
            <label
              for="mensaje"
              class="block text-xs font-black uppercase tracking-wider mb-1.5 text-primary"
            >
              Mensaje
            </label>

            <textarea
              id="mensaje"
              name="message"
              rows="3"
              required
              placeholder="¿En qué puedo ayudarte?"
              class="w-full bg-background border-2 border-border p-3.5 text-sm font-medium focus:outline-none focus:border-primary resize-none"
            ></textarea>
          </div>

          <button
            id="submit-button"
            type="submit"
            class="inline-flex items-center justify-center w-full h-13 bg-primary border-[3px] border-border text-primary-foreground shadow-[6px_6px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Enviar Mensaje 🚀
          </button>

          <p
            id="form-message"
            class="hidden text-sm font-bold text-center"
            aria-live="polite"
          >
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;

  const submitButton = document.getElementById(
    "submit-button",
  ) as HTMLButtonElement | null;

  const formMessage = document.getElementById(
    "form-message",
  ) as HTMLParagraphElement | null;

  if (form && submitButton && formMessage) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);

      formData.append("access_key", WEB3FORMS_ACCESS_KEY);

      formData.append("subject", "Nuevo mensaje desde mi portafolio");

      formData.append("from_name", "Portafolio");

      const originalText = submitButton.textContent;

      submitButton.textContent = "Enviando...";
      submitButton.disabled = true;

      formMessage.classList.add("hidden");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (response.ok) {
          formMessage.textContent = "¡Mensaje enviado correctamente! 🚀";

          formMessage.classList.remove("hidden");
          form.reset();
        } else {
          formMessage.textContent = "Error: " + data.message;

          formMessage.classList.remove("hidden");
        }
      } catch {
        formMessage.textContent = "Ocurrió un error. Inténtalo nuevamente.";

        formMessage.classList.remove("hidden");
      } finally {
        submitButton.textContent = originalText;
        submitButton.disabled = false;
      }
    });
  }
</script>
