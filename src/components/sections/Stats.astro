---
import { ESTADISTICAS } from "@/const";
import DecoCorners from "@/components/DecoCorners.astro";

const decoraciones = [
  { simbolo: "+", color: "text-accent-pink", pos: "top-6 left-8", tamano: "text-4xl" },
  { simbolo: "✱", color: "text-accent-yellow", pos: "bottom-10 right-8", tamano: "text-5xl" },
];
---

<section
  id="stats"
  class="relative w-full px-4 sm:px-6 lg:px-12 py-12 sm:py-16 overflow-hidden"
  aria-label="Estadísticas profesionales"
>
  <DecoCorners decoraciones={decoraciones} />
  <div class="max-w-6xl mx-auto w-full">
    <div
      class="grid grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6 lg:gap-8 items-stretch"
    >
      {ESTADISTICAS.map((stat, index) => (
        <div
          class:list={[
            "relative bg-background border-[3px] border-border p-5 sm:p-6 flex flex-col justify-between overflow-hidden shadow-[6px_6px_0_0_var(--border)]",
            index === 3 &&
              "bg-accent-yellow -rotate-1 lg:-translate-y-2 lg:-rotate-1",
          ]}
        >
          <span
            class="absolute top-3 right-4 text-xs font-black text-primary select-none"
            aria-hidden="true"
            >//</span
          >
          <p
            class="text-4xl sm:text-5xl font-black tracking-tight leading-none"
          >
            {stat.valor}
          </p>
          <p
            class="mt-3 text-[11px] sm:text-xs font-bold uppercase tracking-wider"
          >
            {stat.etiqueta}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>