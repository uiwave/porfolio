---
import Heading from "@/components/Heading.astro";
import { EXPERIENCIAS } from "@/const";
---

<section
  id="experiencia"
  class="relative w-full py-10 px-4 sm:px-6 lg:px-12 overflow-hidden"
>
  <div class="max-w-6xl mx-auto w-full">
    <Heading badge="💼 Trayectoria" title="Experiencia" highlight="Laboral" />
    <div class="relative">
      <div
        class="absolute left-2.25 top-2 bottom-2 border-l-2 border-dashed border-border"
        aria-hidden="true"
      ></div>
      <div class="flex flex-col gap-6 lg:gap-8">
        {EXPERIENCIAS.map((exp) => (
          <div class="relative pl-12">
            <span
              class="absolute left-0 top-1.5 w-5 h-5 rotate-45 bg-primary border-2 border-border shadow-[2px_2px_0_0_var(--border)]"
              aria-hidden="true"
            ></span>
            <span
              class="inline-block mb-3 border-2 border-border bg-primary text-primary-foreground px-3 py-1.5 text-xs font-black uppercase shadow-[3px_3px_0_0_var(--border)]"
            >
              {exp.periodo}
            </span>
            <div
              class="bg-background border-2 border-border p-4 sm:p-5 shadow-[4px_4px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_var(--border)] transition-all duration-150"
            >
              <h3 class="font-black text-base sm:text-lg uppercase tracking-tight leading-tight">
                {exp.puesto}
              </h3>
              <span
                class="text-xs font-black uppercase text-primary tracking-wider"
              >
                // {exp.empresa}
              </span>
              <p class="mt-2 text-sm font-medium leading-relaxed">
                {exp.descripcion}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
