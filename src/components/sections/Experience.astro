---
import Heading from "@/components/Heading.astro";
import { EXPERIENCIAS } from "@/const";
import DecoCorners from "@/components/DecoCorners.astro";

const decoraciones = [
  { simbolo: "✕", color: "text-primary", pos: "top-6 right-8", tamano: "text-4xl" },
  { simbolo: "*", color: "text-accent-pink", pos: "bottom-10 left-8", tamano: "text-4xl" },
];
---

<section
  id="experiencia"
  class="relative w-full py-16 sm:py-24 px-4 sm:px-6 lg:px-12 overflow-hidden"
>
  <DecoCorners decoraciones={decoraciones} />
  <div class="max-w-6xl mx-auto w-full">
    <Heading badge="💼 Trayectoria" title="Experiencia" highlight="Laboral" />
    <div class="relative">
      <div
        class="absolute left-2.25 top-2 bottom-2 border-l-2 border-dashed border-border"
        aria-hidden="true"
      ></div>
      <div class="flex flex-col gap-8 lg:gap-10">
        {EXPERIENCIAS.map((exp) => (
          <div class="relative pl-12">
            <span
              class="absolute left-0 top-1.5 w-5 h-5 rotate-45 bg-primary border-2 border-border shadow-[2px_2px_0_0_var(--border)]"
              aria-hidden="true"
            ></span>
            <span
              class="absolute left-12 -top-3 z-10 border-[3px] border-border bg-primary text-primary-foreground px-3 py-1.5 text-xs font-black uppercase shadow-[3px_3px_0_0_var(--border)]"
            >
              {exp.periodo}
            </span>
            <div
              class="card-fold relative bg-background border-[3px] border-border p-6 sm:p-8 shadow-[6px_6px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_var(--border)] transition-all duration-150"
            >
              <h3
                class="font-black text-lg sm:text-xl uppercase tracking-tight leading-tight underline decoration-accent-yellow decoration-4 underline-offset-4"
              >
                {exp.puesto}
              </h3>
              <span
                class="text-xs font-black uppercase text-primary tracking-wider"
              >
                // {exp.empresa}
              </span>
              <p class="mt-3 text-base font-medium leading-relaxed">
                {exp.descripcion}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>