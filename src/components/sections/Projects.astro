---
import { getCollection } from "astro:content";
import GithubIcon from "@/assets/icons/github.svg";
import Heading from "@/components/Heading.astro";
import DecoCorners from "@/components/DecoCorners.astro";

const proyectos = (await getCollection("projects")).filter(
  (p) => p.data.featured,
);

const decoraciones = [
  { simbolo: "+", color: "text-accent-pink", pos: "top-6 right-8", tamano: "text-4xl" },
  { simbolo: "✱", color: "text-accent-yellow", pos: "bottom-10 left-8", tamano: "text-5xl" },
];
---

<section
  id="proyectos"
  class="relative w-full py-16 sm:py-24 px-4 sm:px-6 lg:px-12 overflow-hidden"
>
  <DecoCorners decoraciones={decoraciones} />
  <div class="max-w-6xl mx-auto w-full">
    <Heading badge="🚀 Portafolio" title="Proyectos" highlight="Destacados" />
    {
      proyectos.length > 0 ? (
        <div class="relative">
          <div
            class="absolute left-2.25 top-2 bottom-2 border-l-2 border-dashed border-border"
            aria-hidden="true"
          ></div>
          <div class="flex flex-col gap-8 lg:gap-10">
            {proyectos.map((proyecto) => (
              <div class="relative pl-12">
                <span
                  class="absolute left-0 top-1.5 w-5 h-5 rotate-45 bg-primary border-2 border-border shadow-[2px_2px_0_0_var(--border)]"
                  aria-hidden="true"
                ></span>
                <span
                  class="absolute left-10 -top-3 z-10 border-[3px] border-border bg-primary text-primary-foreground px-3 py-1.5 text-xs font-black uppercase shadow-[3px_3px_0_0_var(--border)]"
                >
                  {proyecto.data.categoria}
                </span>
                <article
                  class="card-fold relative grid grid-cols-1 md:grid-cols-12 bg-background border-[3px] border-border shadow-[6px_6px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_var(--border)] transition-all duration-150"
                >
                  <div
                    class="relative md:col-span-5 md:self-stretch overflow-hidden h-56 sm:h-64 border-b-[3px] md:border-b-0 md:border-r-[3px] border-border"
                  >
                    <img
                      src={proyecto.data.img}
                      alt={`Captura del proyecto ${proyecto.data.title}`}
                      loading="lazy"
                      class="absolute inset-0 w-full h-full object-cover"
                    />
                  </div>
                  <div
                    class="md:col-span-7 p-6 sm:p-8 flex flex-col gap-5"
                  >
                    <div>
                      <h3
                        class="font-black text-2xl sm:text-3xl uppercase tracking-tight leading-tight underline decoration-accent-yellow decoration-4 underline-offset-4"
                      >
                        {proyecto.data.title}
                      </h3>
                      <div class="mt-4 flex flex-wrap gap-2">
                        {proyecto.data.tech.map((tech, index) => (
                          <span
                            class:list={[
                              "px-2.5 py-0.5 border-2 border-border font-bold text-xs uppercase",
                              index === 0
                                ? "bg-accent-yellow text-foreground"
                                : "bg-primary text-primary-foreground",
                            ]}
                          >
                            {tech}
                          </span>
                        ))}
                      </div>
                      <p class="mt-4 text-base font-medium leading-relaxed">
                        {proyecto.data.description}
                      </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-3">
                      {proyecto.data.github && (
                        <a
                          href={proyecto.data.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`Ver el código en GitHub de ${proyecto.data.title}`}
                          class="inline-flex items-center justify-center gap-2 px-5 h-11 bg-primary border-[3px] border-border text-primary-foreground font-bold text-sm uppercase shadow-[5px_5px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[7px_7px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                        >
                          <GithubIcon class="w-4 h-4" />
                          GitHub
                        </a>
                      )}
                      {proyecto.data.demo && (
                        <a
                          href={proyecto.data.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`Ver la demo de ${proyecto.data.title}`}
                          class="group inline-flex items-center justify-center gap-2 px-5 h-11 bg-accent-yellow text-foreground border-[3px] border-border font-bold text-sm uppercase shadow-[5px_5px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[7px_7px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                        >
                          Previsualización
                          <span
                            class="inline-block transition-transform duration-150 group-hover:translate-x-1"
                            aria-hidden="true"
                            >→</span
                          >
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p
          class="bg-background border-[3px] border-border p-6 font-black uppercase text-center shadow-[6px_6px_0_0_var(--border)]"
        >
          Próximamente...
        </p>
      )
    }
  </div>
</section>