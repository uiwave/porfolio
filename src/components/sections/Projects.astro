---
import { getCollection } from "astro:content";
import GithubIcon from "@/assets/icons/github.svg";
import Heading from "@/components/Heading.astro";

const proyectos = (await getCollection("projects")).filter(
  (p) => p.data.featured,
);
---

<section
  id="proyectos"
  class="relative w-full py-16 sm:py-24 px-4 sm:px-6 lg:px-12 overflow-hidden"
>
  <div class="max-w-6xl mx-auto w-full">
    <Heading badge="🚀 Portafolio" title="Proyectos" highlight="Destacados" />
    {
      proyectos.length > 0 ? (
        <div class="flex flex-col gap-6 lg:gap-8">
          {proyectos.map((proyecto, index) => (
            <article
              class="grid grid-cols-1 md:grid-cols-12 bg-background border-2 border-border shadow-[5px_5px_0_0_var(--border)] hover:shadow-[8px_8px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-150 overflow-hidden"
            >
              <div
                class:list={[
                  "relative md:col-span-5 md:h-64 lg:h-72 border-b-2 md:border-b-0 border-border",
                  index % 2 === 1 && "md:order-2 md:border-l-2",
                  index % 2 === 0 && "md:border-r-2",
                ]}
              >
                <img
                  src={proyecto.data.img}
                  alt={`Captura del proyecto ${proyecto.data.title}`}
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </div>
              <div
                class:list={[
                  "md:col-span-7 p-5 sm:p-6 flex flex-col gap-4",
                  index % 2 === 1 && "md:order-1",
                ]}
              >
                <div>
                  <h3 class="font-black text-xl sm:text-2xl uppercase tracking-tight leading-tight">
                    {proyecto.data.title}
                  </h3>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {proyecto.data.tech.map((tech) => (
                      <span
                        class="px-2.5 py-0.5 border-2 border-border bg-primary text-primary-foreground font-bold text-xs uppercase"
                      >
                        {tech}
                      </span>
                    ))}
                  </div>
                  <p class="mt-3 text-sm font-medium leading-relaxed">
                    {proyecto.data.description}
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-2 mt-auto pt-2">
                  {proyecto.data.github && (
                    <a
                      href={proyecto.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Ver el código en GitHub de ${proyecto.data.title}`}
                      class="inline-flex items-center justify-center gap-2 px-4 h-10 bg-primary border-2 border-border text-primary-foreground font-bold text-sm uppercase shadow-[4px_4px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                    >
                      <GithubIcon class="w-4 h-4" />
                      GitHub
                    </a>
                  )}
                  {proyecto.data.demo && (
                    <a
                      href={proyecto.data.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Ver la demo de ${proyecto.data.title}`}
                      class="inline-flex items-center justify-center px-4 h-10 bg-primary border-2 border-border text-primary-foreground font-bold text-sm uppercase shadow-[4px_4px_0_0_var(--border)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_var(--border)] active:translate-x-1 active:translate-y-1 active:shadow-none transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                    >
                      Previsualización 🚀
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p
          class="bg-background border-2 border-border p-6 font-black uppercase text-center shadow-[5px_5px_0_0_var(--border)]"
        >
          Próximamente...
        </p>
      )
    }
  </div>
</section>