---
interface Props {
  badge: string;
  title: string;
  highlight: string;
}

const { badge, title, highlight } = Astro.props;
---

<div class="mb-8 sm:mb-10 text-left">
  <div
    class="inline-flex items-center gap-2 px-2.5 py-0.5 mb-2.5 border-2 border-border bg-primary text-primary-foreground font-bold text-xs uppercase shadow-[2px_2px_0px_0px_var(--border)]"
  >
    {badge}
  </div>
  <h2
    class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight leading-tight"
  >
    {title}{" "}
    <span
      class="bg-primary text-primary-foreground px-2 py-0.5 inline-block border-2 border-border shadow-[3px_3px_0_0_var(--border)] ml-1"
    >
      {highlight}
    </span>
  </h2>
</div>
